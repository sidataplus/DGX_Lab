{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dgxlab.local/schemas/course.schema.json",
  "title": "DGX Lab course",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "revision",
    "title",
    "language",
    "modules"
  ],
  "properties": {
    "schema": {
      "const": "dgxlab.course/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "revision": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "language": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "lab_path",
          "competencies"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "lab_path": {
            "type": "string"
          },
          "competencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "estimated_minutes": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
